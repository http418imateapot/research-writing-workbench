{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/research-writing-workbench/corpus-snapshot.schema.json",
  "title": "Research Corpus Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "captured_at", "searches", "included_source_ids", "excluded_sources", "input_hashes"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "snapshot_id": {"type": "string", "pattern": "SNAP-[A-Z0-9][A-Z0-9-]{2,63}"},
    "captured_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
    "searches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["database", "query", "searched_at", "result_count"],
        "properties": {
          "database": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "searched_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
          "result_count": {"type": "integer"}
        }
      }
    },
    "included_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "excluded_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "reason"],
        "properties": {"source_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
      }
    },
    "input_hashes": {"type": "object"}
  }
}

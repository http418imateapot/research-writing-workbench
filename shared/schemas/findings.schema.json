{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/research-writing-workbench/findings.schema.json",
  "title": "Research Findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "findings"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "generated_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "target_ids", "source_ids", "method", "result", "severity", "requires_review", "limitations"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "F-[A-Z0-9][A-Z0-9-]{2,63}"},
          "target_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "method": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "kind", "inputs", "output"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "enum": ["deterministic", "ai-assisted"]},
              "inputs": {"type": "object"},
              "output": {"type": "object"}
            }
          },
          "result": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "requires_review": {"type": "boolean"},
          "limitations": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

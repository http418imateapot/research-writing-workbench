{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/research-writing-workbench/research-evidence.schema.json",
  "title": "Research Evidence and Claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "evidence", "claims"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "updated_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "statement", "classification", "source_refs", "method", "scope", "limitations", "confidence", "status"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "EV-[A-Z0-9][A-Z0-9-]{2,63}"},
          "statement": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["explicit", "derived", "inference", "assumption", "recommendation"]},
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator"],
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string", "minLength": 1}
              }
            }
          },
          "method": {"type": "string", "minLength": 1},
          "derivation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method_id", "version", "inputs", "reproducible"],
            "properties": {
              "method_id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "inputs": {"type": "array", "items": {"type": "string"}},
              "reproducible": {"type": "boolean"}
            }
          },
          "scope": {"type": "string", "minLength": 1},
          "limitations": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "enum": ["low", "medium", "high", "not-assessed"]},
          "status": {"type": "string", "enum": ["draft", "reviewed", "invalidated"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "claim_type", "evidence_ids", "scope", "limitations", "status", "active", "researcher_decision"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "CL-[A-Z0-9][A-Z0-9-]{2,63}"},
          "text": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string", "enum": ["implementation", "behavior", "comparison", "mechanism", "transfer"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "scope": {"type": "string", "minLength": 1},
          "limitations": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["draft", "reviewed", "confirmed", "withdrawn"]},
          "active": {"type": "boolean"},
          "researcher_decision": {"type": "string", "enum": ["keep", "narrow", "rework", "withdraw", "pending"]}
        }
      }
    }
  }
}

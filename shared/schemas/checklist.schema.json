{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/research-writing-workbench/checklist.schema.json",
  "title": "Research Review Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "finding_id", "priority", "status", "affected_ids", "source_hashes", "history"],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "FP-[A-F0-9]{24}"},
          "finding_id": {"type": "string"},
          "priority": {"type": "string", "enum": ["low", "medium", "high"]},
          "status": {"type": "string", "enum": ["open", "in_review", "closed"]},
          "affected_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_hashes": {"type": "object"},
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "event", "reason"],
              "properties": {
                "at": {"type": "string", "minLength": 1},
                "event": {"type": "string", "enum": ["opened", "reopened", "close", "reopen", "waive"]},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "action", "reviewer", "reviewed_at"],
            "properties": {
              "decision_id": {"type": "string"},
              "action": {"type": "string", "enum": ["close", "reopen", "waive"]},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"}
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/research-writing-workbench/decision-log.schema.json",
  "title": "Research Decision Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "fingerprint", "action", "reviewer", "reviewed_at", "reason"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "D-[A-Z0-9][A-Z0-9-]{2,63}"},
          "fingerprint": {"type": "string", "pattern": "FP-[A-F0-9]{24}"},
          "action": {"type": "string", "enum": ["close", "reopen", "waive"]},
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
          "reason": {"type": "string", "minLength": 1},
          "approver": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"}
        }
      }
    }
  }
}
